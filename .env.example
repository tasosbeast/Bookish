NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://bookish:bookish@localhost:5432/bookish?schema=public
# Generate two DIFFERENT secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CLIENT_ORIGIN=http://localhost:5173
# Production requires the exact HTTPS frontend origin, without a trailing slash.
# Set only to the number of trusted reverse proxies in your deployment; keep 0 for direct traffic.
TRUST_PROXY_HOPS=0
# Optional. Exact hosts allowed for new profile picture URLs. HTTPS only.
# A *.example.com entry allows subdomains of that host, not the host itself.
# Unset uses Gravatar's gravatar.com, www, secure, s, and 0-2 hosts, plus
# lh3.googleusercontent.com through lh6.googleusercontent.com.
# Listing hosts replaces the default, so repeat any defaults you still want.
# Keep this identical to the frontend VITE_AVATAR_ALLOWED_HOSTS value.
# AVATAR_ALLOWED_HOSTS=www.gravatar.com,lh3.googleusercontent.com
# Web Push VAPID configuration (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Penguin Random House Enhanced API key
PRH_API_KEY=
