# Required during production builds. Include /api; use the public HTTPS API URL.
# Production frontend and backend must share the same site for refresh cookies.
VITE_API_BASE_URL=http://localhost:3000/api
# Optional. Same rules and the same value as the API AVATAR_ALLOWED_HOSTS.
# Unset uses the built-in Gravatar and lh3–lh6.googleusercontent.com hosts.
# VITE_AVATAR_ALLOWED_HOSTS=www.gravatar.com,lh3.googleusercontent.com
