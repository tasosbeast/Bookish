{
  "name": "bookish-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "catalog:import": "node scripts/import-catalog.js",
    "catalog:launch-import": "node scripts/launch-import-catalog.js",
    "catalog:csv-import": "node scripts/import-catalog-csv.js",
    "catalog:repair-launch": "node scripts/repair-launch-catalog.js",
    "catalog:genre-import": "node scripts/import-catalog-genres.js",
    "catalog:publication-dates": "node scripts/import-catalog-publication-dates.js",
    "catalog:release-import": "node scripts/import-release-catalog.js",
    "catalog:resolve": "node scripts/resolve-catalog.js",
    "catalog:pilot-plan": "node scripts/catalog-pilot-plan.js",
    "catalog:status": "node scripts/catalog-status.js",
    "catalog:snapshot-build": "node scripts/snapshot-build.js",
    "catalog:snapshot-status": "node scripts/snapshot-status.js",
    "catalog:disk-preflight": "node scripts/catalog-disk-preflight.js",
    "catalog:bulk-smoke": "node scripts/catalog-bulk-smoke.js",
    "catalog:ol-range-sample": "node scripts/catalog-ol-range-sample.js",
    "catalog:ol-author-index-build": "node scripts/ol-author-index-build.js",
    "catalog:ol-snapshot-build": "node scripts/ol-snapshot-build.js",
    "release:readiness": "node scripts/release-data-readiness.js",
    "release:prh-sync": "node scripts/sync-prh-releases.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.3"
  },
  "devDependencies": {
    "prisma": "^7.0.0",
    "supertest": "^7.1.4"
  }
}
